# Copy to .env — never commit .env
NODE_ENV=development
TZ=Asia/Tashkent
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
BRAND_NAME=Orbita
DEFAULT_LOCALE=uz

DATABASE_URL=postgresql://orbita:orbita_dev_only@localhost:5432/orbita
DATABASE_URL_TEST=postgresql://orbita:orbita_dev_only@localhost:5432/orbita_test

# Only where binaries.prisma.sh is unreachable (restricted CI/sandbox): point the CLI at a stub so
# `prisma generate`/`validate` run on their bundled WASM, and use `pnpm --filter @orbita/api db:wasm:*`
# for migrations. Leave unset on normal machines.
# PRISMA_SCHEMA_ENGINE_BINARY=

# 64+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me

# mock | anthropic   (keep mock until legal review — OPEN_QUESTIONS Q20)
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Orbita <no-reply@orbita.local>"

STORAGE_DRIVER=local
STORAGE_DIR=./storage
